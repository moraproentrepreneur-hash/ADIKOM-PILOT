# =============================================================================
# ADIKOM PILOT — Variables d'environnement
#
# Copiez ce fichier en `.env.local` et renseignez les valeurs réelles.
#
# RÈGLE ABSOLUE : `.env.local` ne doit JAMAIS être commité.
# Aucune valeur réelle ne doit apparaître dans le code, la documentation,
# le README, CLAUDE.md ou un commit Git (CLAUDE.md §25, README §42).
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Tableau de bord Supabase → Project Settings → API

# URL du projet. Exposée au navigateur : ce n'est pas un secret.
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"

# Clé publique (anon / publishable). Exposée au navigateur.
# La sécurité repose sur RLS, pas sur le secret de cette clé.
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-cle-publique"

# ⚠ SECRET — clé de service. Contourne RLS.
# Utilisée EXCLUSIVEMENT côté serveur (création de comptes par le Super Admin).
# Ne doit jamais être préfixée NEXT_PUBLIC_ ni atteindre le navigateur.
SUPABASE_SERVICE_ROLE_KEY="votre-cle-de-service"

# ⚠ SECRET — chaîne de connexion PostgreSQL (contient le mot de passe).
# Project Settings → Database → Connection string (URI)
# Remplacer [YOUR-PASSWORD] par le mot de passe défini à la création du projet.
#
# Sert uniquement aux opérations d'administration du schéma depuis le poste de
# développement : db:push, db:verify, db:inspect.
# N'est PAS nécessaire sur Vercel : l'application n'applique pas de migrations.
SUPABASE_DB_URL="postgresql://postgres.votre-ref:MOT_DE_PASSE@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Application -------------------------------------------------------------

# URL publique de l'application (liens dans les emails, redirections d'auth).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
